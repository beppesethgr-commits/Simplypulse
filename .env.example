PORT=3000
SESSION_SECRET=cambia-questo-valore-lungo-e-casuale

# Utente iniziale della dashboard, creato al primo avvio (se data/users.json non esiste)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-password

# demo = dati fittizi | live = WService Midware
DATA_MODE=demo

# --- WService Midware (SimplyDevelop) ---
# Indirizzo del WService, porta 3055 (es. https://192.168.1.10:3055)
MIDWARE_BASE_URL=https://127.0.0.1:3055
# Utente creato in WService > gestione utenti > sezione Midware
MIDWARE_USER=
MIDWARE_PASSWORD=
# true se il WService usa un certificato autofirmato
MIDWARE_INSECURE_TLS=true
# Tipi di documento considerati vendite (VEN=ricevute, DCC/DUC=documenti cliente)
MIDWARE_DOC_TYPES=VEN,DCC,DUC
# Secondi di cache delle letture, per non sovraccaricare il WService
MIDWARE_CACHE_SECONDS=60
