PORT=3000
SESSION_SECRET=cambia-questo-valore-lungo-e-casuale

# Utente iniziale creato al primo avvio (se data/users.json non esiste)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-password

# demo = dati fittizi | live = web service Midware
DATA_MODE=demo

# --- Web service Midware / SimplyDevelop ---
MIDWARE_BASE_URL=https://tuo-server-midware/api
# none | bearer | apikey | basic
MIDWARE_AUTH=bearer
MIDWARE_TOKEN=
MIDWARE_API_KEY_HEADER=X-API-Key
MIDWARE_USER=
MIDWARE_PASSWORD=
